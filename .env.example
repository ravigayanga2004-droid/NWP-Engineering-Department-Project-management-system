# Copy to .env.local and fill in. Never commit .env.local.
# Local values: run `npx supabase status` after `npx supabase start`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# "Publishable key" (older Supabase CLI: "anon key")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "Secret key" (older Supabase CLI: "service_role key"). SERVER ONLY – never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
